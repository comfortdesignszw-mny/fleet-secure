# GEMINI_API_KEY: Optional AI Studio environment key (unused by Fleet Secure core).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where Fleet Secure is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Strong random string (32+ chars) for signing HttpOnly session cookies.
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Initial Admin Seed Credentials (forced PIN change on first login)
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PIN="1234"
INITIAL_ADMIN_NAME="Fleet Administrator"

# Email Notifications (Phase 5 - Resend or compatible API)
RESEND_API_KEY=""
EMAIL_FROM="Fleet Secure <noreply@example.com>"

# Preview Sandbox Mode (enables self-service Admin signup & sample fleet loader; set "false" in production)
ALLOW_PREVIEW_SIGNUP="true"
